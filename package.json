{
  "name": "prompt-tikz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "next dev --webpack -p 3111 --experimental-https --experimental-https-key ./mkcert/localhost+3-key.pem --experimental-https-cert ./mkcert/localhost+3.pem",
    "dev:serve": "bash scripts/dev-serve.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "biome check .",
    "format": "biome format --write .",
    "postinstall": "bash scripts/copy-tikzjax.sh"
  },
  "dependencies": {
    "@rod2ik/tikzjax": "^1.5.2",
    "fflate": "^0.8.3",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jotai": "^2.20.2",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
