{
  "name": "tikzard",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liyu1981/tikzard.git"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev --webpack -p 3111 --experimental-https --experimental-https-key ./mkcert/localhost+3-key.pem --experimental-https-cert ./mkcert/localhost+3.pem",
    "dev:serve": "bash scripts/dev-serve.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "build": "next build --webpack",
    "start": "next start -p 4000",
    "lint": "biome check .",
    "format": "biome format --write .",
    "postinstall": "bash scripts/copy-tikzjax.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@rod2ik/tikzjax": "^1.6.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jotai": "^2.20.2",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
