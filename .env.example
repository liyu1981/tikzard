# Copy to .env for local development. In production, set these as real
# environment variables of the machine/CI that runs `pnpm build` — they are
# read while the root layout is rendered (prerendered at build time).

# Google Analytics 4 measurement ID (https://support.google.com/analytics/answer/12270856)
# Leave unset to disable analytics entirely.
GA_MEASUREMENT_ID=G-XXXXXXXXXX
